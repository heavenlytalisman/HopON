rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read profiles (needed for search, squad members)
      allow read: if request.auth != null;
      // Only the user themselves can update their profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups collection
    match /groups/{groupId} {
      // Any authenticated user can read or create groups
      // More fine-grained logic could restrict writing to only members
      allow read, write: if request.auth != null;
    }

    // Posts collection
    match /posts/{postId} {
      // Any authenticated user can read and create posts
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Only the author can update/delete their post
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Notification requests collection
    match /notification_requests/{requestId} {
      // Users can only create requests (no reading, modifying, or deleting)
      allow create: if request.auth != null;
    }
    
    // Friend requests collection
    match /friend_requests/{requestId} {
      // Users can only read requests involving them
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }
  }
}
