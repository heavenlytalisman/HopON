rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // Function to check if array modification only affects the current user
      function onlyAffectsAuthUser(oldArray, newArray) {
        let added = newArray.removeAll(oldArray);
        let removed = oldArray.removeAll(newArray);
        return (added.size() == 0 || (added.size() == 1 && added[0] == request.auth.uid)) &&
               (removed.size() == 0 || (removed.size() == 1 && removed[0] == request.auth.uid));
      }

      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']))
        ||
        (request.auth.uid != userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'following']) &&
         (!('followers' in request.resource.data) || onlyAffectsAuthUser(resource.data.get('followers', []), request.resource.data.followers)) &&
         (!('following' in request.resource.data) || onlyAffectsAuthUser(resource.data.get('following', []), request.resource.data.following))
        )
      );
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Groups / Squads collection
    match /groups/{groupId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.members);
      allow create: if request.auth != null && request.resource.data.members.hasAny([request.auth.uid]);
      
      allow update: if request.auth != null && (
        // Case 1: Owner updating the group
        (request.auth.uid in resource.data.members && resource.data.ownerId == request.auth.uid)
        ||
        // Case 2: Non-owner member updating the group
        (
          request.auth.uid in resource.data.members && 
          resource.data.ownerId != request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'avatar', 'name', 'wallpaper', 'wallpaperOpacity', 'ringtone']) &&
          request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
        )
        ||
        // Case 3: Non-member joining the group
        (
          !(request.auth.uid in resource.data.members) &&
          (request.auth.uid in request.resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );
      
      // Group deletion happens when the last member leaves
      allow delete: if request.auth != null && (request.auth.uid in resource.data.members) && resource.data.members.size() <= 1;
    }

    // Messages subcollection
    match /groups/{groupId}/messages/{messageId} {
      // Users can only read messages if they are a member of the group
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      // Users can only send messages if they are a member of the group
      allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      allow update, delete: if false;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      // Allow the author to update anything, but allow any authenticated user to ONLY update social interaction fields
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes', 'replies', 'comments', 'reposts']) &&
         (!('likes' in request.resource.data) || request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1 || request.resource.data.likes == resource.data.likes)
        )
      );
    }

    // Friendships collection
    match /friendships/{friendshipId} {
      // Users can only read friendships where they are either user1 or user2
      allow read: if request.auth != null && (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
      allow create: if request.auth != null && (request.resource.data.user1Id == request.auth.uid || request.resource.data.user2Id == request.auth.uid) && !exists(/databases/$(database)/documents/friendships/$(friendshipId));
      allow update, delete: if request.auth != null && (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
    }
    
    // Active Rooms collection
    match /active_rooms/{squadId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(squadId)).data.members;
      allow create, update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(squadId)).data.members;
      allow delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(squadId)).data.members;
    }

    // Friend requests collection
    match /friend_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read and manage their own notifications
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Prevent Notification Spoofing: Sender ID must match authenticated user, or system-generated (no senderId)
      allow create: if request.auth != null && (!('senderId' in request.resource.data) || request.resource.data.senderId == request.auth.uid); 
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Notification Requests collection (Cloud Function trigger)
    match /notification_requests/{requestId} {
      // Authenticated users can queue a push notification
      allow create: if request.auth != null;
      // Only the Cloud Function (admin) can read/update/delete
      allow read, update, delete: if false;
    }
  }
}
